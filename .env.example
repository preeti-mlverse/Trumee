# ── Core
DATABASE_URL=postgres://trumee:trumee@localhost:5434/trumee
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# ── First admin account (created by `npm run db:seed`)
ADMIN_EMAIL=admin@trumee.in
ADMIN_PASSWORD=change-me

# ── Payments (Razorpay). Leave blank to run checkout in test "simulated" mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend). Leave blank to log emails to the server console.
RESEND_API_KEY=
EMAIL_FROM="Trumee <orders@trumee.in>"

# ── Image uploads (Vercel Blob). Leave blank to store uploads in public/uploads (dev only).
BLOB_READ_WRITE_TOKEN=

# ── Shipping (Shiprocket). Optional: enables one-click shipment creation from an order.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ── Cron protection for /api/cron/* (abandoned-cart emails)
CRON_SECRET=change-me

# ── Search engines: paste the verification codes from Google Search Console / Bing Webmaster Tools
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
